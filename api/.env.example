# Copy to .env (never commit .env). Development works with no .env at all.
# Local: `npm run mongo:dev` starts a replica set on 27018 (transactions need one). Render: use a MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27018/stitch?directConnection=true
PORT=4000

# Required in production
NODE_ENV=development
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
TENANT_NAME=Stitch
TENANT_SLUG=stitch

# Comma separated list of sites allowed to call the API (the frontend URL on Render)
CORS_ORIGIN=
# off = do not run the webhook delivery loop in this process
WEBHOOK_WORKER=on

# Reading WhatsApp chats into leads (docs/EXTRACTION_FLOW.md). Without a key the Chats page still uploads, but cannot read.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Groq's on-demand tier allows 8,000 tokens a minute, answer included. These keep one read under that;
# raise them after upgrading the Groq tier. Chars = newest part of a long chat that is sent; tokens = size of the answer.
# EXTRACT_MAX_CHARS=8000
# EXTRACT_MAX_TOKENS=2500
