# Copy to .env (never commit .env). Development works with no .env at all.
# Local: `npm run mongo:dev` starts a replica set on 27018 (transactions need one). Render: use a MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27018/stitch?directConnection=true
PORT=4000

# Required in production
NODE_ENV=development
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
TENANT_NAME=Stitch
TENANT_SLUG=stitch

# Comma separated list of sites allowed to call the API (the frontend URL on Render)
CORS_ORIGIN=
# off = do not run the webhook delivery loop in this process
WEBHOOK_WORKER=on
