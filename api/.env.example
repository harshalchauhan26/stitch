# Copy to .env (never commit .env). Development works with no .env at all.
# Local: `npm run mongo:dev` starts a replica set on 27018 (transactions need one). Render: use a MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27018/stitch?directConnection=true
PORT=4000

# Required in production
NODE_ENV=development
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
TENANT_NAME=Stitch
TENANT_SLUG=stitch

# Comma separated list of sites allowed to call the API (the frontend URL on Render)
CORS_ORIGIN=
# off = do not run the webhook delivery loop in this process
WEBHOOK_WORKER=on

# E-mails to the team (docs/MAILER.md). off = do not run the sending loop in this process (mails are still queued).
MAIL_WORKER=on
# Without SMTP_HOST the mails are only printed to the console (dry run). To send for real: npm install nodemailer, then set
# these for any provider that offers SMTP (Brevo, Resend, SES, Gmail...).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Stitch <alerts@example.com>
# The frontend's address: when set, each mail ends with an "Open in Stitch" link.
# APP_URL=

# Reading WhatsApp chats into leads (docs/EXTRACTION_FLOW.md). Without a key the Chats page still uploads, but cannot read.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Groq's on-demand tier allows 8,000 tokens a minute, answer included. These keep one read under that;
# raise them after upgrading the Groq tier. Chars = newest part of a long chat that is sent; tokens = size of the answer.
# EXTRACT_MAX_CHARS=8000
# EXTRACT_MAX_TOKENS=2500

# Shopify product sync (Products page -> "Sync from Shopify"). One store per brand, named by the brand's code (here brand NA).
# The token only needs the read_products scope. Leave these out until a brand's store is connected.
# SHOPIFY_NA_DOMAIN=noor-atelier.myshopify.com
# SHOPIFY_NA_TOKEN=
# SHOPIFY_API_VERSION=2025-01
