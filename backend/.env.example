# Copy this file to ".env" (same folder) for local development. In production set these as real environment variables instead.

# --- chat reading with AI (optional) ---
# Without a key Stitch still reads chats, but only fills phone, country, brand and keyword hints.
ANTHROPIC_API_KEY=
# Cheap and fast model for reading chats. Change only if you have a reason to.
STITCH_LLM_MODEL=claude-haiku-5-5

# --- production only (NODE_ENV=production) ---
# Random string, 32+ characters. Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
# The first admin, created only when the database is empty. The server refuses to start in production without them.
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_PASSWORD=a-long-password-of-10-plus-characters
# Where the database lives (put it on a persistent disk) and where backups go.
# DB_FILE=/data/stitch.db
# BACKUP_DIR=/data/backups
# Only if the frontend is hosted on a DIFFERENT site than the API (comma separated). Leave empty for the single-container setup.
# CORS_ORIGIN=https://app.yourcompany.com
# Sign-in lock: wrong attempts allowed per email and per address, and how long the lock lasts.
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_MINUTES=15
